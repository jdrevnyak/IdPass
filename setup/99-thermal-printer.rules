# Symcode MJ-5890K 58mm Thermal Printer
# Allow non-root access and prevent usblp from claiming it
SUBSYSTEM=="usb", ATTR{idVendor}=="0416", ATTR{idProduct}=="5011", MODE="0666", GROUP="plugdev"
ATTR{idVendor}=="0416", ATTR{idProduct}=="5011", ENV{LIBUSB_FORCE}="1", RUN+="/bin/sh -c 'echo -n $kernel > /sys/bus/usb/drivers/usblp/unbind 2>/dev/null || true'"
